PORT=3000
CUE_DB_FILE=cue.db
# 32 random bytes, base64. Create one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CUE_SECRET_KEY=
# Set to 1 only for development against a local fake Canvas.
CUE_ALLOW_INSECURE_CANVAS=
# Log in with Canvas: set all three or none. The URL is the address phones use.
# CUE_CANVAS_URL=
# CUE_CANVAS_CLIENT_ID=
# CUE_CANVAS_CLIENT_SECRET=
